# Variables para Portainer. No guardar valores reales en Git.
POSTGRES_PASSWORD=
# Imagen publicada por GitHub Actions, o imagen construida en el NAS.
API_IMAGE=ghcr.io/sga1d0s/jaguar-industries-api:sha-REEMPLAZAR
WEB_IMAGE=ghcr.io/sga1d0s/jaguar-industries-web:sha-REEMPLAZAR
JAGUAR_BIND_IP=192.168.1.96
JAGUAR_HTTP_PORT=3080
JAGUAR_WEB_PORT=3082
# Acceso LAN para pgAdmin; 15432 ya lo utiliza Ibex.
JAGUAR_DB_PORT=15433
# Solo al incluir compose.tunnel.yaml:
CLOUDFLARED_IMAGE=
TUNNEL_TOKEN=

# Contraseña independiente del rol limitado de la API (mínimo 20 caracteres).
APP_DATABASE_PASSWORD=
