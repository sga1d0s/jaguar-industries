{
  "expo": {
    "name": "Jaguar Industries",
    "slug": "jaguar-industries",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.industriasjaguar.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.industriasjaguar.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "jaguar",
    "plugins": [
      "expo-secure-store",
      "expo-router"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0ce754ea-1352-4b24-9087-7aaf83e4acee"
      }
    },
    "owner": "sgaldos"
  }
}
